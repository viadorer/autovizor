VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sauto.cz Import API (pro sync službu)
SAUTO_LOGIN=your-login
SAUTO_PASSWORD=your-password
SAUTO_SOFTWARE_KEY=your-software-key

# VIN Decoder - vindecoder.eu API (volitelné, pro kompletní výbavu z VIN)
# Registrace: https://www.vindecoder.eu/my/api
VITE_VINDECODER_API_KEY=your-api-key
VITE_VINDECODER_SECRET=your-secret

# Gemini AI — natural language search (volitelné)
VITE_GEMINI_API_KEY=your-gemini-api-key

# Cloudflare R2 — image storage (server-side only, viz scripts/import-tipcars.mjs)
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=autovizor
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Public R2 URL — používaná v UI (manufacturer logos, vehicle images)
VITE_R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Cloudflare Worker pro upload fotek z prohlížeče (Sell wizard)
# Po deploy přes wrangler v cloudflare/photo-uploader/
VITE_PHOTO_UPLOADER_URL=https://autovizor-photo-uploader.<account>.workers.dev
